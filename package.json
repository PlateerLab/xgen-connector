{
  "name": "xgen-connector",
  "version": "1.9.2",
  "description": "XGEN Connector - desktop client to log in to an XGEN instance, browse your agents, and chat (SSE streaming). Works with agent_geny / agent_xgen / agent_harness agents.",
  "author": "PlateerLab",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/PlateerLab/xgen-connector",
  "repository": {
    "type": "git",
    "url": "https://github.com/PlateerLab/xgen-connector.git"
  },
  "scripts": {
    "test": "tsx --test test/client.test.ts test/connection-security.test.ts test/diag-log.test.ts test/exec-resolve.test.ts test/fuse-mount.test.ts test/harness.test.ts test/mcp-import.test.ts test/mcp-progress.test.ts test/mcp-spawn.test.ts test/sse.test.ts test/sync-convergence.test.ts test/sync-dataloss.test.ts test/sync-platform.test.ts test/tool-activity.test.ts test/update-source.test.ts test/webdav-server.test.ts test/workspace-backend.test.ts test/workspace-mounts.test.ts test/workspace.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\"",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v7": "^4.2.114",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pixi/unsafe-eval": "^7.4.3",
    "electron-updater": "^6.3.9",
    "keytar": "^7.9.0",
    "pixi-live2d-display": "^0.5.0-beta",
    "pixi.js": "^7.4.3",
    "ws": "^8.21.0",
    "chokidar": "^4.0.3",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "@types/picomatch": "^4.0.0"
  },
  "optionalDependencies": {
    "@cocalc/fuse-native": "^2.4.3"
  }
}
